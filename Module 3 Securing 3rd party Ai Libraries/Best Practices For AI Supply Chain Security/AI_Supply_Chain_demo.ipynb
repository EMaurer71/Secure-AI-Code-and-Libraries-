        "## Practice 1: Lock Files for Deterministic Builds\n",
        "\n",
        "**Goal:** Prevent version drift and hidden vulnerability introduction by:\n",
        "\n",
        "- Using `requirements.in` for *high‑level* dependencies  \n",
        "- Generating a pinned `requirements.lock` with `pip-compile`  \n",
        "- Enforcing hash verification with `--require-hashes`  \n",
        "\n",
        "This gives you **reproducible, auditable builds** across all environments."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {},
      "execution_count": null,
      "outputs": [],
      "source": [
        "print(\"\\n\" + \"=\"*70)\n",
        "print(\"PRACTICE 1: LOCK FILES - Deterministic Builds\")\n",
        "print(\"=\"*70)\n",
        "\n",
        "print(\"\\nWhy Lock Files Matter:\")\n",
        "print(\"  • requirements.txt allows version ranges (>=, ~=)\")\n",
        "print(\"  • Different installations get different versions\")\n",
        "print(\"  • New vulnerabilities can be introduced silently\")\n",
        "print(\"  • Build reproducibility is impossible\")\n",
        "\n",
        "# Create sample requirements.in (input file)\n",
        "requirements_in = \"\"\"# Core ML Dependencies\n",
        "numpy>=1.21.0\n",
        "pandas>=1.3.0\n",
        "scikit-learn>=1.0.0\n",
        "torch>=1.10.0\n",
        "matplotlib>=3.4.0\n",
        "\"\"\"\n",
        "\n",
        "with open('requirements.in', 'w') as f:\n",
        "    f.write(requirements_in)\n",
        "\n",
        "print(\"\\n[Input: requirements.in]\")\n",
        "print(requirements_in)\n",
        "\n",
        "print(\"\\n[Generating Lock File with pip-tools]\")\n",
        "print(\"Command: pip-compile requirements.in --output-file requirements.lock\")\n",
        "print(\"\\nNote: Install pip-tools with: pip install pip-tools\")\n",
        "\n",
        "# Simulated lock file (matches the lab demo)\n",
        "requirements_lock = \"\"\"# This file is autogenerated by pip-compile with Python 3.9\n",
        "# To update, run: pip-compile requirements.in\n",
        "\n",
        "certifi==2023.7.22\n",
        "    # via requests\n",
        "charset-normalizer==3.2.0\n",
        "    # via requests\n",
        "contourpy==1.1.0\n",
        "    # via matplotlib\n",
        "cycler==0.11.0\n",
        "    # via matplotlib\n",
        "filelock==3.12.2\n",
        "    # via torch\n",
        "fonttools==4.42.0\n",
        "    # via matplotlib\n",
        "fsspec==2023.6.0\n",
        "    # via torch\n",
        "idna==3.4\n",
        "    # via requests\n",
        "jinja2==3.1.2\n",
        "    # via torch\n",
        "joblib==1.3.2\n",
        "    # via scikit-learn\n",
        "kiwisolver==1.4.4\n",
        "    # via matplotlib\n",
        "markupsafe==2.1.3\n",
        "    # via jinja2\n",
        "matplotlib==3.7.2\n",
        "    # via -r requirements.in\n",
        "mpmath==1.3.0\n",
        "    # via sympy\n",
        "networkx==3.1\n",
        "    # via torch\n",
        "numpy==1.24.3\n",
        "    # via -r requirements.in\n",
        "    # via contourpy\n",
        "    # via matplotlib\n",
        "    # via pandas\n",
        "    # via scikit-learn\n",
        "    # via scipy\n",
        "    # via torch\n",
        "packaging==23.1\n",
        "    # via matplotlib\n",
        "pandas==2.0.3\n",
        "    # via -r requirements.in\n",
        "pillow==10.0.0\n",
        "    # via matplotlib\n",
        "pyparsing==3.0.9\n",
        "    # via matplotlib\n",
        "python-dateutil==2.8.2\n",
        "    # via matplotlib\n",
        "    # via pandas\n",
        "pytz==2023.3\n",
        "    # via pandas\n",
        "requests==2.31.0\n",
        "    # via torchvision\n",
        "scikit-learn==1.3.0\n",
        "    # via -r requirements.in\n",
        "scipy==1.11.1\n",
        "    # via scikit-learn\n",
        "six==1.16.0\n",
        "    # via python-dateutil\n",
        "sympy==1.12\n",
        "    # via torch\n",
        "threadpoolctl==3.2.0\n",
        "    # via scikit-learn\n",
        "torch==2.0.1\n",
        "    # via -r requirements.in\n",
        "torchvision==0.15.2\n",
        "    # via -r requirements.in (implied)\n",
        "typing-extensions==4.7.1\n",
        "    # via torch\n",
        "tzdata==2023.3\n",
        "    # via pandas\n",
        "urllib3==2.0.4\n",
        "    # via requests\n",
        "\n",
        "# Total: 41 packages (10 direct + 31 transitive)\n",
        "\"\"\"\n",
        "\n",
        "with open('requirements.lock', 'w') as f:\n",
        "    f.write(requirements_lock)\n",
        "\n",
        "print(\"✓ Generated requirements.lock\")\n",
        "print(\"  Direct dependencies: 5\")\n",
        "print(\"  Total pinned packages: 41 (including transitive)\")\n",
        "print(\"  Every version is exact (no ranges)\")\n",
        "\n",
        "print(\"\\n[Adding Hash Verification]\")\n",
        "print(\"Command: pip-compile --generate-hashes requirements.in\")\n",
        "print(\"\\nHash verification ensures package integrity:\")\n",
        "\n",
        "hash_example = r\"\"\"\n",
        "numpy==1.24.3 \\\n",
        "    --hash=sha256:ab344f1bf21f140adab8e47fdbc7c35a477dc01408791f8ba00d018dd0bc5155 \\\n",
        "    --hash=sha256:2fa0b7b5d9e6c7a8f8af23b5b8d9e9e5a1f2e4f3c4e5f6a7b8c9d0e1f2a3b4c5\n",
        "\"\"\"\n",
        "print(hash_example)\n",
        "print(\"Installation command: pip install --require-hashes -r requirements.lock\")\n",
        "\n",
        "print(\"\\n✅ Benefits:\")\n",
        "print(\"  • Deterministic builds across all environments\")\n",
        "print(\"  • Hash verification prevents package tampering\")\n",
        "print(\"  • Explicit dependency tree for auditing\")\n",
        "print(\"  • Version drift prevention\")"
      ]
    },
