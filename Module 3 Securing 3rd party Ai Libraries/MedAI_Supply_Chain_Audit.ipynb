    "\n",
    "with open(\"requirements.lock\", \"w\") as f:\n",
    "    f.write(requirements_lock)\n",
    "\n",
    "print(\"✓ requirements.lock written\")\n",
    "print(requirements_lock.splitlines()[0])"
   ]
  },
