    "        },\n",
    "        {\n",
    "            \"type\": \"library\",\n",
    "            \"name\": \"scikit-learn\",\n",
    "            \"version\": \"1.3.0\",\n",
    "            \"licenses\": [{\"license\": {\"id\": \"BSD-3-Clause\"}}],\n",
    "            \"purl\": \"pkg:pypi/scikit-learn@1.3.0\"\n",
    "        },\n",
    "        {\n",
    "            \"type\": \"library\",\n",
    "            \"name\": \"numpy\",\n",
    "            \"version\": \"1.24.3\",\n",
    "            \"licenses\": [{\"license\": {\"id\": \"BSD-3-Clause\"}}],\n",
    "            \"purl\": \"pkg:pypi/numpy@1.24.3\"\n",
    "        },\n",
    "        {\n",
    "            \"type\": \"library\",\n",
    "            \"name\": \"Flask\",\n",
    "            \"version\": \"2.3.2\",\n",
    "            \"licenses\": [{\"license\": {\"id\": \"BSD-3-Clause\"}}],\n",
    "            \"purl\": \"pkg:pypi/Flask@2.3.2\"\n",
