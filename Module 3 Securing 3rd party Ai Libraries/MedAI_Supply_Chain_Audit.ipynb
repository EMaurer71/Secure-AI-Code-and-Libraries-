    "- `tensorflow` (Apache 2.0) – compatible\n",
    "- `scikit-learn` (BSD 3-Clause) – compatible\n",
    "- `pyqt5` (GPL v3) – incompatible, must be replaced\n",
    "- `unknown-utils` (UNKNOWN) – requires legal review."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "licenses = [\n",
    "    {\n",
    "        \"package\": \"tensorflow\",\n",
    "        \"license\": \"Apache-2.0\",\n",
    "        \"compatibility\": \"Compatible\",\n",
    "        \"regulatory_risk\": \"Low - Permissive for commercial use.\"\n",
    "    },\n",
    "    {\n",
    "        \"package\": \"scikit-learn\",\n",
    "        \"license\": \"BSD-3-Clause\",\n",
    "        \"compatibility\": \"Compatible\",\n",
    "        \"regulatory_risk\": \"Low - Permissive for commercial use.\"\n",
    "    },\n",
